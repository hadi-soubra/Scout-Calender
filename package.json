{
  "name": "scout-calendar",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix web run build",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply scout-calendar --local",
    "db:migrate:remote": "wrangler d1 migrations apply scout-calendar --remote",
    "seed:local": "node scripts/seed-users.mjs --local",
    "seed:remote": "node scripts/seed-users.mjs --remote"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  }
}
